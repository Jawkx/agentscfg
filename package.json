{
  "name": "agentscfg",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "main": "./dist/cli.cjs",
  "bin": {
    "agentscfg": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "SEMVER.md"
  ],
  "scripts": {
